SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
PEXELS_API_KEY=your_pexels_key
# Optional — animated/cartoon styles prefer Pixabay; absent → Pexels-only
# PIXABAY_API_KEY=your_pixabay_key
# Or rely on parent ../.env.local for local OpenAI key
OPENAI_API_KEY=sk-...
WORKER_ID=local-dev-1
LEASE_SECONDS=600
POLL_MS=3000
# Parallel Pexels/vision beat resolves (default 3, max 8; try 4 on Oracle)
# BROLL_CONCURRENCY=4
# Set to 1 only to skip real FFmpeg and use a sample URL
STUB_RENDER=0
RENDERS_BUCKET=renders
# Object storage backend: "supabase" (default) or "r2"
# STORAGE_BACKEND=supabase
# R2 settings (only needed when STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=shortclips-renders
# R2_PUBLIC_BASE_URL=https://cdn.example.com
# Retention sweep cadence (default 15 min)
# RETENTION_SWEEP_MS=900000
CLIP_DOWNLOAD_TIMEOUT_MS=180000
# Optional: force system binaries (needed on ARM if *-static packages lack arm64)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Set to 1 on ~1–2 GB hosts to encode one clip at a time (avoids OOM; more CPU with captions)
# FFMPEG_LOW_MEM=1
# FFmpeg -threads / -filter_threads (default 1; on 4 vCPU try 2 or 3)
# FFMPEG_THREADS=2
